# ---- server ----
HOST=0.0.0.0
PORT=4173
KVNP_DATA_DIR=/app/data
KVNP_SESSION_SECRET=replace-with-a-long-random-string-before-deploy
KVNP_COOKIE_SECURE=false
KVNP_PUBLIC_URL=https://passport.kvnp.ca
DOMAIN=passport.kvnp.ca
ACME_EMAIL=you@example.com

# ---- photo engine ----
KVNP_QUALITY_MODEL=birefnet-portrait
KVNP_MATTING_ENGINE=birefnet
KVNP_ONNX_PROVIDER=auto
KVNP_ONNX_THREADS=2
KVNP_MAX_CONCURRENT_JOBS=2
# true = restore the old per-country "validation only" locks (no background clean-up)
KVNP_STRICT_POLICY=false
KVNP_PHOTO_RETENTION_DAYS=30

# ---- plans & prices (minor units: 10000 = CAD 100.00) ----
KVNP_PRICE_SINGLE_MINOR=999
KVNP_PRICE_SILVER_MONTHLY_MINOR=10000
KVNP_PRICE_SILVER_YEARLY_MINOR=99900
# USD prices shown to US visitors (minor units)
KVNP_PRICE_SINGLE_USD_MINOR=799
KVNP_PRICE_SILVER_MONTHLY_USD_MINOR=7500
KVNP_PRICE_SILVER_YEARLY_USD_MINOR=74900

# ---- Stripe (disabled | stripe) ----
KVNP_PAYMENT_MODE=disabled
STRIPE_RESTRICTED_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SILVER_MONTHLY=price_replace_me
STRIPE_PRICE_SILVER_YEARLY=price_replace_me
STRIPE_PRICE_SINGLE=price_replace_me
# USD versions of the same three prices (leave blank to sell in CAD only)
STRIPE_PRICE_SILVER_MONTHLY_USD=
STRIPE_PRICE_SILVER_YEARLY_USD=
STRIPE_PRICE_SINGLE_USD=
STRIPE_CURRENCY=CAD
# set true only after enabling Stripe Tax (origin address + GST/HST registration) in the Stripe dashboard
STRIPE_AUTOMATIC_TAX=false
STRIPE_INTEGRATION_IDENTIFIER=

# ---- email (SMTP; AWS SES SMTP credentials work) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=starttls
MAIL_FROM=no-reply@passport.kvnp.ca
MAIL_FROM_NAME=PassportLens
# where contact-form enquiries are sent (comma-separated for several)
KVNP_CONTACT_EMAIL=

# ---- database (PostgreSQL override) ----
POSTGRES_PASSWORD=replace-with-a-separate-long-random-string
